---
import { getCollection } from 'astro:content';

import { Content } from '../../content/blocks/registers.md';

import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Heading from '@/components/Heading.astro';
import RegisterList from '@/components/RegisterList.astro';

import config from '@/config';

const { title, description } = config.pages.registers;
const entries = await getCollection('registers');

const operational = entries.filter((entry) => entry.data.status === 'operational').length;
const proposed = entries.length - operational;
---

<Layout title={title} description={description}>
  <Hero title={title} description={description} />

  <Section>
    <div class="prose">
      <Content />
    </div>
  </Section>

  <Section variant="gray">
    <Heading title="The registers" />
    <p class="counts">
      <strong>{operational}</strong> operational, <strong>{proposed}</strong> proposed. Grouped by the
      UNECE site each one resides on. A proposed register has no link because there is nothing yet to
      link to.
    </p>
    <RegisterList entries={entries} />
  </Section>
</Layout>

<style lang="scss">
  .prose {
    max-width: var(--measure);

    :global(p) {
      font-size: var(--font-size-lg);
    }
  }

  .counts {
    max-width: var(--measure);
    padding-left: 1em;
    color: var(--color-gray-700);
    border-left: 3px solid var(--color-gray-300);
  }
</style>
