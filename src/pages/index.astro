---
import { getCollection } from 'astro:content';

import { Content as Principle } from '../../content/blocks/home-principle.md';

import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Button from '@/components/Button.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';

import config from '@/config';

const { title, description } = config.pages.home;
const catalogue = await getCollection('catalogue');

const homes = [
  {
    home: "A standards body's own infrastructure",
    holds:
      'Normative specifications and their registers. UNICC GitLab for UN/CEFACT, the WCO for the Data Model, the W3C for the credential and identifier specifications.',
    accountable: "That body's process and members",
  },
  {
    home: 'The Global Trade Commons',
    holds: 'Implementations, tooling, operated services and adoption material.',
    accountable: 'The foundation, as a funded entity that can hold an obligation',
  },
  {
    home: "A community's own infrastructure",
    holds: 'Its extension, its overlay rules, its profile.',
    accountable: 'That community',
  },
  {
    home: "A vendor's own repositories",
    holds: 'Its supported connectors and products.',
    accountable: 'The vendor',
  },
];
---

<Layout title={title} description={description}>
  <Hero variant="full" title={title} description={description} notice={config.formingNotice}>
    <Button href="/about" title="What the Commons does" />
    <Button href="/components" title="See the components" variant="outline" />
  </Hero>

  <Section>
    <Heading title="The organising principle" />
    <div class="prose">
      <Principle />
    </div>
  </Section>

  <Section variant="gray">
    <Heading title="Where things live">
      <Button
        href="/components"
        title={`${catalogue.length} components`}
        icon="arrow-right"
        iconPosition="end"
        variant="link"
      />
    </Heading>
    <p class="lead">
      Four kinds of home, with four answers to the question of who is accountable when something
      breaks. The component catalogue spans all four, so an entry frequently points somewhere other
      than this organisation.
    </p>
    <ul class="homes">
      {
        homes.map(({ home, holds, accountable }) => (
          <li>
            <h3>{home}</h3>
            <p>{holds}</p>
            <p class="homes_accountable">
              <span>Accountable</span>
              {accountable}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <Heading title="What the Commons does not do" />
    <p class="lead">
      The Commons implements standards governed by others. It holds no normative authority over any of
      them, authors none of them, and coordinates with each through liaison on the same terms. Nothing
      in this organisation forks a specification: schemas, contexts, vocabularies and registers are
      referenced at their published location, never copied in.
    </p>
    <Button href="/about" title="Read the full scope" icon="arrow-right" iconPosition="end" />
  </Section>
</Layout>

<style lang="scss">
  .prose {
    max-width: var(--measure);

    :global(p) {
      font-size: var(--font-size-lg);
    }
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--font-size-lg);
  }

  .homes {
    margin: var(--spacing-md) 0 0 0;
    padding: 0;
    display: grid;
    list-style: none;
    gap: var(--spacing-sm);
    grid-template-columns: repeat(2, minmax(0, 1fr));

    li {
      margin: 0;
      display: flex;
      flex-direction: column;
      padding: var(--spacing-md);
      background: var(--color-bg);
      border-radius: var(--border-radius-sm);
      border: 1px solid var(--color-gray-200);
    }

    h3 {
      margin: 0 0 0.6em 0;
      font-size: var(--font-size-h5);
    }

    p {
      margin: 0;
      color: var(--color-gray-800);
    }

    &_accountable {
      margin-top: auto !important;
      padding-top: 1.1em;
      font-size: var(--font-size-sm);
      line-height: var(--line-height-sm);

      span {
        display: block;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        color: var(--color-gray-500);
        font-size: var(--font-size-xs);
        font-weight: var(--font-weight-semibold);
      }
    }

    @media screen and (max-width: 768px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
