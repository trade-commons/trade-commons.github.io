---
import { getCollection } from 'astro:content';

import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Button from '@/components/Button.astro';
import Heading from '@/components/Heading.astro';
import Section from '@/components/Section.astro';

import config from '@/config';

const { title, description } = config.pages.home;

const specifications = (await getCollection('specifications')).sort(
  (a, b) => a.data.order - b.data.order,
);

// A landing page orients and routes. Everything below has a page of its own, and the job here is to
// say which page answers which question.
const routes = [
  {
    url: '/roles',
    name: 'What your organisation would run',
    note: 'The catalogue arranged by the job you have, because an organisation knows its own role long before it knows which component it needs. Each role names the business case that argues for it.',
  },
  {
    url: '/value',
    name: 'Why anyone adopts',
    note: 'The UN/CEFACT business cases, by audience. Customs, tax, ports, banks, traders, industry and the trust infrastructure everything depends on.',
  },
  {
    url: '/components',
    name: 'What exists',
    note: 'The component catalogue: libraries, services and applications, where each one lives today, and what is proposed and does not exist yet.',
  },
  {
    url: '/conformance',
    name: 'How you prove it works',
    note: 'From building to being listed in a UN register: deploy, integrate, test, certify where a register asks for it, register.',
  },
  {
    url: '/governance',
    name: 'Who decides',
    note: 'How the Commons is constituted, where normative authority rests, and the arrangements that keep contribution and control apart.',
  },
];
---

<Layout title={title} description={description}>
  <Hero variant="full" title={title} description={description} notice={config.formingNotice}>
    <Button href="/components" title="See the components" />
    <Button href="/roles" title="Start with your role" variant="outline" />
  </Hero>

  <Section>
    <Heading title="The specifications this work supports" />
    <p class="lead">
      The Commons builds tooling for these and governs none of them. UN/CEFACT owns and governs all
      three, with its secretariat hosted by UNECE. Each link goes to the specification itself.
    </p>
    <ul class="specs">
      {
        specifications.map(({ data }) => (
          <li>
            <h3>
              <a href={data.url} target="_blank" rel="noreferrer">
                {data.name}
              </a>
            </h3>
            <p class="specs_abbr">{data.abbreviation}</p>
            <p>{data.summary}</p>
            {data.note && <p class="specs_note">{data.note}</p>}
          </li>
        ))
      }
    </ul>
  </Section>

  <Section variant="gray">
    <Heading title="Who this is for, and where to start" />
    <p class="lead">
      Implementers. A company publishing data about what it makes, an agency receiving it, a scheme
      owner publishing the criteria others are assessed against, a registration authority issuing
      identity anchors, a vendor building a product that does any of those. If you are still deciding
      whether to adopt, start with the business cases. If you have decided, start with your own role.
    </p>

    <p class="aside">
      <strong>Starting or running a community activation programme is documented elsewhere.</strong>
      The methodology, and the case for a sector adopting together instead of one company at a time,
      are maintained by UN/CEFACT, and the sectoral forums support their member communities directly:
      <a href="https://agrifood.untp.unece.org" target="_blank" rel="noreferrer">agriculture and food</a>,
      <a href="https://metals.untp.unece.org" target="_blank" rel="noreferrer">minerals and metals</a>,
      <a href="https://textiles.untp.unece.org" target="_blank" rel="noreferrer">textiles</a>. The
      Commons supplies what a community publishes with, meaning the profile template, the extension
      structure and the validator, and does not run the programme.
    </p>

    <ul class="routes">
      {
        routes.map(({ url, name, note }) => (
          <li>
            <a href={url}>{name}</a>
            <p>{note}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section>
    <p class="closing">
      The Commons implements standards governed by others and holds no normative authority over any
      of them. What follows from that, and the rules it imposes on everything here, is the substance
      of the next page.
    </p>
    <Button href="/about" title="Scope, and the rules that hold it" icon="arrow-right" iconPosition="end" variant="link" />
  </Section>
</Layout>

<style lang="scss">
  .lead {
    max-width: var(--measure);
    font-size: var(--font-size-lg);
  }

  .aside {
    max-width: var(--measure);
    padding-left: 1em;
    color: var(--color-gray-700);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-md);
    border-left: 3px solid var(--color-ochre-500);
  }

  .closing {
    max-width: var(--measure);
    font-size: var(--font-size-lg);
  }

  .specs {
    margin: var(--spacing-md) 0 0 0;
    padding: 0;
    display: grid;
    list-style: none;
    gap: var(--spacing-sm);
    grid-template-columns: repeat(3, minmax(0, 1fr));

    li {
      margin: 0;
      display: flex;
      flex-direction: column;
      padding: var(--spacing-md);
      background: var(--color-gray-50);
      border-radius: var(--border-radius-sm);
      border: 1px solid var(--color-gray-200);
    }

    h3 {
      margin: 0;
      font-size: var(--font-size-h5);

      a {
        text-decoration: none;

        &:hover {
          text-decoration: underline;
        }
      }
    }

    p {
      margin: 0.75em 0 0 0;
      color: var(--color-gray-800);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-md);
    }

    &_abbr {
      margin-top: 0.3em !important;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-gray-500);
      font-size: var(--font-size-xs) !important;
      font-weight: var(--font-weight-semibold);
    }

    &_note {
      margin-top: auto !important;
      padding-top: 1em;
      color: var(--color-gray-600);
      font-size: var(--font-size-xs) !important;
    }

    @media screen and (max-width: 768px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .routes {
    margin: var(--spacing-sm) 0 0 0;
    padding: 0;
    display: grid;
    list-style: none;
    gap: var(--spacing-sm);
    grid-template-columns: repeat(2, minmax(0, 1fr));

    li {
      margin: 0;
      padding: var(--spacing-md);
      background: var(--color-bg);
      border-radius: var(--border-radius-sm);
      border: 1px solid var(--color-gray-200);
    }

    a {
      text-decoration: none;
      font-family: var(--font-serif, var(--font-fallback-serif));
      font-size: var(--font-size-h5);
      font-weight: var(--font-weight-semibold);
      color: var(--color-petrol-700);

      &:hover {
        text-decoration: underline;
      }
    }

    p {
      margin: 0.6em 0 0 0;
      color: var(--color-gray-800);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-md);
    }

    @media screen and (max-width: 768px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
