---
import { getCollection } from 'astro:content';

import { Content } from '../../content/blocks/get-involved.md';

import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/Hero.astro';
import Section from '@/components/Section.astro';
import Heading from '@/components/Heading.astro';
import CatalogueList from '@/components/CatalogueList.astro';
import { entriesFor } from '@/utils/placement';

import config from '@/config';

const { title, description } = config.pages.getInvolved;

// Templates are starting points a community or a vendor copies and then owns, so they belong beside
// the instructions for doing that and not in a catalogue of things the Commons maintains.
const catalogue = await getCollection('catalogue');
const templates = catalogue
  .filter((entry) => entry.data.tier === 'template')
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
entriesFor(catalogue, '/get-involved', templates);
---

<Layout title={title} description={description}>
  <Hero title={title} description={description} />
  <Section>
    <div class="prose">
      <Content />
    </div>
  </Section>

  <Section variant="gray">
    <Heading title="What you start from" />
    <p class="lead">
      Copy these and they are yours. The Commons maintains the template; what you build from it is
      your programme's or your company's, published on your own infrastructure.
    </p>
    <CatalogueList entries={templates} grouped={false} />
  </Section>
</Layout>

<style lang="scss">
  .lead {
    max-width: var(--measure);
    color: var(--color-gray-700);
  }

</style>
