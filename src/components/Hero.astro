---
interface Props {
  title: string;
  description?: string;
  notice?: string;
  variant?: 'full' | 'compact';
}

const { title, description, notice, variant = 'compact' } = Astro.props;
---

<section class:list={['hero', variant]}>
  <div class="hero_content">
    {notice && <p class="hero_notice">{notice}</p>}
    <h1>{title}</h1>
    {description && <p class="hero_description">{description}</p>}
    <slot />
  </div>
</section>

<style lang="scss">
  @use 'styles/mixins.scss';

  .hero {
    color: var(--color-white);
    background: var(--color-brand-800);
    background-image: linear-gradient(140deg, var(--color-brand-800) 0%, var(--color-brand-600) 100%);

    &_content {
      @include mixins.wrapper();
      padding-block: var(--content-padding-block);
    }

    &.full &_content {
      padding-block: calc(1.75 * var(--content-padding-block));
    }

    h1 {
      margin: 0;
      max-width: 22ch;
      color: currentColor;
    }

    &_notice {
      margin: 0 0 1.25em 0;
      max-width: var(--measure);
      padding-left: 0.9em;
      color: rgb(from var(--color-white) r g b / 78%);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-sm);
      border-left: 2px solid rgb(from var(--color-white) r g b / 35%);
    }

    &_description {
      margin: 1em 0 0 0;
      max-width: var(--measure);
      font-size: var(--font-size-xl);
      line-height: var(--line-height-sm);
      color: rgb(from var(--color-white) r g b / 88%);
    }

    :global(.button) {
      margin-top: 1.75em;
      margin-right: 0.5em;
    }

    :global(.button.primary) {
      --text-color: var(--color-brand-800);
      --background-color: var(--color-white);
    }

    :global(.button.primary:hover) {
      --background-color: var(--color-gray-200);
    }

    :global(.button.outline) {
      --text-color: var(--color-white);
      --border-color: rgb(from var(--color-white) r g b / 55%);
    }

    :global(.button.outline:hover) {
      --background-color: rgb(from var(--color-white) r g b / 12%);
    }

    @media screen and (max-width: 480px) {
      &_description {
        font-size: var(--font-size-lg);
      }
    }
  }
</style>
