---
import type { CollectionEntry } from 'astro:content';

import { pageFor } from '@/utils/placement';

interface Props {
  steps: CollectionEntry<'journey'>[];
  catalogue: CollectionEntry<'catalogue'>[];
}

const { steps, catalogue } = Astro.props;
const component = new Map(catalogue.map((entry) => [entry.id, entry]));
// Where a component is shown decides the link. Only the tiers that the Components page renders have
// an anchor to aim at; the others moved to pages of their own.
const hrefFor = (entry?: { id: string; data: { tier: string } }) => {
  if (!entry) return '/components';
  const page = pageFor(entry);
  return page === '/components' ? `/components#${entry.data.tier}` : page;
};
---

<ol class="steps">
  {
    steps.map(({ id, data }, index) => (
      <li class="step" id={id}>
        <div class="step_marker" aria-hidden="true">
          {index + 1}
        </div>
        <div class="step_body">
          <h3>{data.name}</h3>
          <p>{data.summary}</p>
          {data.components.length > 0 && (
            <ul class="uses">
              {data.components.map((ref) => {
                const c = component.get(ref);
                return (
                  <li>
                    <a href={hrefFor(c)}>{c?.data.name ?? ref}</a>
                    {c?.data.maturity === 'proposed' && <span class="pending">proposed</span>}
                  </li>
                );
              })}
            </ul>
          )}
        </div>
      </li>
    ))
  }
</ol>

<style lang="scss">
  .steps {
    margin: 0;
    padding: 0;
    display: grid;
    list-style: none;
    gap: var(--spacing-md);
    counter-reset: step;
  }

  .step {
    margin: 0;
    gap: var(--spacing-sm);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    scroll-margin-top: calc(var(--header-height) + 1rem);

    &_marker {
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--color-white);
      background: var(--color-petrol-600);
      font-family: var(--font-serif, var(--font-fallback-serif));
      font-size: var(--font-size-md);
      font-weight: var(--font-weight-semibold);
    }

    &_body {
      max-width: var(--measure);

      h3 {
        margin: 0.25em 0 0 0;
        font-size: var(--font-size-h5);
      }

      p {
        margin: 0.6em 0 0 0;
        color: var(--color-gray-800);
      }
    }

    // A rule down the left, so the sequence reads as one run rather than five cards.
    &:not(:last-child) &_marker {
      position: relative;

      &::after {
        content: '';
        position: absolute;
        top: 2.6rem;
        bottom: calc(-1 * var(--spacing-md) - 0.35rem);
        left: 50%;
        width: 1px;
        background: var(--color-gray-300);
      }
    }
  }

  .uses {
    gap: 0.4em;
    margin: 0.9em 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    list-style: none;

    li {
      margin: 0;
      gap: 0.4em;
      display: inline-flex;
      align-items: center;
      // Keeps the tap target at the 24px minimum; these chips are links.
      min-height: 24px;
      padding: 0.2em 0.6em;
      font-size: var(--font-size-sm);
      border-radius: var(--border-radius-xs);
      background: var(--color-gray-100);
    }

    a {
      // The anchor is the tap target, not the chip around it, so the 24px minimum goes here.
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .pending {
    color: var(--color-gray-500);
    font-size: var(--font-size-xs);
  }
</style>
