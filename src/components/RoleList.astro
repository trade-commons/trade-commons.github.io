---
import type { CollectionEntry } from 'astro:content';

interface Props {
  roles: CollectionEntry<'roles'>[];
  catalogue: CollectionEntry<'catalogue'>[];
}

const { roles, catalogue } = Astro.props;

const component = new Map(catalogue.map((entry) => [entry.id, entry.data]));
const roleName = new Map(roles.map((role) => [role.id, role.data.name]));
// Tooling lives on the Testing page now, so a link to /components#tooling would be dead.
const hrefFor = (tier?: string) => (tier === 'tooling' ? '/conformance' : `/components#${tier ?? ''}`);
---

<ul class="roles">
  {
    roles.map(({ id, data }) => (
      <li class="role" id={id}>
        <h3>{data.name}</h3>
        <p class="role_summary">{data.summary}</p>

        {data.operates.length > 0 && (
          <div class="block">
            <h4>Runs</h4>
            <ul class="components">
              {data.operates.map((ref) => {
                const c = component.get(ref);
                return (
                  <li>
                    <a href={hrefFor(c?.tier)}>{c?.name ?? ref}</a>
                    {c?.maturity === 'proposed' && <span class="pending">proposed</span>}
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {data.serves.length > 0 && (
          <div class="block">
            <h4>Serves</h4>
            <ul class="served">
              {data.serves.map((ref) => (
                <li>
                  <a href={`#${ref}`}>{roleName.get(ref) ?? ref}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {data.note && <p class="role_note">{data.note}</p>}
      </li>
    ))
  }
</ul>

<style lang="scss">
  .roles {
    margin: 0;
    padding: 0;
    display: grid;
    list-style: none;
    gap: var(--spacing-sm);
    grid-template-columns: repeat(2, minmax(0, 1fr));

    @media screen and (max-width: 768px) {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .role {
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md);
    background: var(--color-bg);
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-gray-200);
    scroll-margin-top: calc(var(--header-height) + 1rem);

    h3 {
      margin: 0;
      font-size: var(--font-size-h5);
    }

    &_summary {
      margin: 0.8em 0 0 0;
      color: var(--color-gray-800);
    }

    &_note {
      margin: 1em 0 0 0;
      padding-left: 0.9em;
      color: var(--color-gray-600);
      font-size: var(--font-size-sm);
      line-height: var(--line-height-sm);
      border-left: 2px solid var(--color-ochre-500);
    }
  }

  .block {
    margin-top: 1.1em;

    &:nth-of-type(2) {
      margin-top: 0.9em;
    }

    h4 {
      margin: 0 0 0.45em 0;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--color-gray-500);
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-semibold);
      font-family: var(--font-sans, var(--font-fallback));
    }
  }

  .components,
  .served {
    gap: 0.4em;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    list-style: none;

    li {
      margin: 0;
      gap: 0.4em;
      display: inline-flex;
      align-items: center;
      // Keeps the tap target at the 24px minimum; these chips are links.
      min-height: 24px;
      padding: 0.2em 0.6em;
      font-size: var(--font-size-sm);
      border-radius: var(--border-radius-xs);
      background: var(--color-gray-100);
    }

    a {
      // The anchor is the tap target, not the chip around it, so the 24px minimum goes here.
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }
  }

  .served li {
    background: transparent;
    border: 1px dashed var(--color-gray-300);
  }

  .pending {
    color: var(--color-gray-500);
    font-size: var(--font-size-xs);
  }
</style>
