---
/**
 * Governance and institutional structure.
 *
 * The member classes are drawn outside the Commons and elect into it, because that is the clearest
 * way to show the principle the page argues: representation comes from what an organisation is, and
 * contribution level has nothing to do with it.
 *
 * The companion figure in funding/gtc-governance.svg is the same structure sized for a Word page;
 * this one carries the site's palette and scales with the viewport.
 */

const CLASSES = ['Commercial', 'Public', 'Civil society'];

const SEATS = [
  'Commercial class — one elected representative',
  'Public class — one elected representative',
  'Civil society class — one elected representative',
  'Implementation and community representative (elected)',
  'Chair of the Technical Steering Committee (by role)',
];

const HOME = {
  initial: {
    tag: 'INITIAL',
    name: 'Linux Foundation',
    sub: 'Directed Fund',
    detail: ['legal personality, banking,', 'contracting, pooled fund'],
  },
  permanent: {
    tag: 'PERMANENT — NOT YET DECIDED',
    // Each option is pre-wrapped, because slicing a label to fit cuts it mid-word.
    options: [['A full Linux Foundation', 'sub-foundation'], ['An IODC sub-foundation']],
    detail: '(established by the GDC)',
  },
};
---

<figure class="gov">
  <div class="gov_scroll">
    <svg viewBox="0 0 1200 572" role="img" aria-labelledby="govTitle govDesc">
      <title id="govTitle">Governance and institutional structure of the Global Trade Commons</title>
      <desc id="govDesc">
        UN/CEFACT holds sole normative authority and UNECE hosts its secretariat. Neither holds a
        seat on the Commons, and the Commons holds none in the UN/CEFACT process; published
        specifications come down and defects and change requests go up. Three member classes,
        commercial, public and civil society, each elect one representative to a Governing Board of
        five voting seats, the other two held by the implementation and community representative and
        the Chair of the Technical Steering Committee. Intergovernmental organisations may take an
        optional liaison seat carrying no vote and no contribution. The Commons begins as a Linux
        Foundation Directed Fund; its permanent home is not yet decided between a full Linux
        Foundation sub-foundation and a sub-foundation of the IODC.
      </desc>

      <defs>
        <marker id="gvA" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L7.5,3 L0,6 Z" fill="#626E7B"/>
        </marker>
        <marker id="gvAs" markerWidth="9" markerHeight="9" refX="0.5" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M7.5,0 L0,3 L7.5,6 Z" fill="#626E7B"/>
        </marker>
        <marker id="gvP" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L7.5,3 L0,6 Z" fill="#0B8171"/>
        </marker>
        <marker id="gvO" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L7.5,3 L0,6 Z" fill="#A1612A"/>
        </marker>
      </defs>

      {/* the standards body */}
      <rect x={390} y={20} width={420} height={130} rx={10} fill="#EFF2F5" stroke="#C8D0D9" stroke-width="1.2"/>
      <rect x={406} y={32} width={388} height={54} rx={6} fill="#FFFFFF" stroke="#C8D0D9" stroke-width="1"/>
      <text x={600} y={54} text-anchor="middle" class="g-h2">UN/CEFACT</text>
      <text x={600} y={73} text-anchor="middle" class="g-sm">Sole normative authority over VOCAB, UNTP, UNVTD and GRID</text>
      <rect x={406} y={94} width={388} height={44} rx={6} fill="#FFFFFF" stroke="#C8D0D9" stroke-width="1"/>
      <text x={600} y={112} text-anchor="middle" class="g-h3">UNECE</text>
      <text x={600} y={129} text-anchor="middle" class="g-sm">Hosts the UN/CEFACT secretariat</text>

      <line x1={600} y1={150} x2={600} y2={200} stroke="#626E7B" stroke-width="1.6"
            marker-start="url(#gvAs)" marker-end="url(#gvA)"/>
      <text x={616} y={168} class="g-it">published specifications (down)</text>
      <text x={616} y={186} class="g-it">defects and change requests (up)</text>
      <text x={584} y={178} text-anchor="end" class="g-warn">no seats either way</text>

      {/* who elects */}
      <rect x={40} y={200} width={250} height={206} rx={10} fill="#F7F9FA" stroke="#0B8171" stroke-width="1.4"/>
      <text x={165} y={226} text-anchor="middle" class="g-h3">Member classes</text>
      <text x={165} y={242} text-anchor="middle" class="g-note">each elects one representative</text>
      {
        CLASSES.map((name, i) => (
          <g>
            <rect x={54} y={252 + i * 42} width={222} height={36} rx={6} fill="#FFFFFF" stroke="#0B8171" stroke-width="1"/>
            <text x={165} y={275 + i * 42} text-anchor="middle" class="g-row">{name}</text>
          </g>
        ))
      }
      <text x={165} y={392} text-anchor="middle" class="g-note">only commercial members carry a funding floor</text>

      <line x1={290} y1={300} x2={326} y2={300} stroke="#0B8171" stroke-width="2.2" marker-end="url(#gvP)"/>

      {/* non-voting liaison */}
      <rect x={40} y={426} width={250} height={58} rx={8} fill="#FDF6EC" stroke="#A1612A" stroke-width="1.2" stroke-dasharray="5 3"/>
      <text x={165} y={448} text-anchor="middle" class="g-row-b">Intergovernmental organisations</text>
      <text x={165} y={466} text-anchor="middle" class="g-amber">optional liaison seat: no vote, no contribution</text>
      <path d="M290,455 L308,455 L308,364 L326,364" fill="none" stroke="#A1612A" stroke-width="1.6"
            stroke-dasharray="5 3" marker-end="url(#gvO)"/>

      {/* the Commons */}
      <rect x={330} y={200} width={540} height={280} rx={10} fill="#E3F1EE" stroke="#0B8171" stroke-width="1.6"/>
      <text x={600} y={228} text-anchor="middle" class="g-h1">Global Trade Commons</text>
      <text x={600} y={246} text-anchor="middle" class="g-sm">Implementation and adoption arm; holds no normative authority</text>

      <rect x={346} y={258} width={508} height={128} rx={8} fill="#FFFFFF" stroke="#0B8171" stroke-width="1"/>
      <text x={600} y={279} text-anchor="middle" class="g-h3">Governing Board — five voting seats, none appointed</text>
      {SEATS.map((seat, i) => <text x={366} y={303 + i * 18} class="g-row">• {seat}</text>)}

      <rect x={346} y={396} width={508} height={50} rx={8} fill="#FFFFFF" stroke="#0B8171" stroke-width="1"/>
      <text x={600} y={416} text-anchor="middle" class="g-h4">Technical Steering Committee</text>
      <text x={600} y={434} text-anchor="middle" class="g-sm">Membership earned through contribution; elects its Chair</text>

      <text x={600} y={468} text-anchor="middle" class="g-note">Board Chair elected from among its members, twelve months renewable once; no casting vote</text>

      {/* where it lives */}
      <rect x={910} y={200} width={250} height={280} rx={10} fill="#F7F9FA" stroke="#626E7B" stroke-width="1.3"/>
      <text x={1035} y={226} text-anchor="middle" class="g-h3">Institutional home</text>

      <rect x={924} y={240} width={222} height={96} rx={6} fill="#FFFFFF" stroke="#0B8171" stroke-width="1.4"/>
      <text x={1035} y={260} text-anchor="middle" class="g-tag">{HOME.initial.tag}</text>
      <text x={1035} y={281} text-anchor="middle" class="g-h4">{HOME.initial.name}</text>
      <text x={1035} y={298} text-anchor="middle" class="g-row">{HOME.initial.sub}</text>
      {HOME.initial.detail.map((d, i) => <text x={1035} y={316 + i * 13} text-anchor="middle" class="g-note">{d}</text>)}

      <rect x={924} y={346} width={222} height={120} rx={6} fill="#FFFFFF" stroke="#626E7B" stroke-width="1.1" stroke-dasharray="5 3"/>
      <text x={1035} y={366} text-anchor="middle" class="g-tag-n">{HOME.permanent.tag}</text>
      {HOME.permanent.options[0].map((line, i) => (
        <text x={1035} y={390 + i * 15} text-anchor="middle" class="g-row">{line}</text>
      ))}
      <text x={1035} y={423} text-anchor="middle" class="g-or">or</text>
      <text x={1035} y={441} text-anchor="middle" class="g-row">{HOME.permanent.options[1][0]}</text>
      <text x={1035} y={456} text-anchor="middle" class="g-note">{HOME.permanent.detail}</text>

      <line x1={870} y1={300} x2={906} y2={300} stroke="#626E7B" stroke-width="1.8" marker-end="url(#gvA)"/>

      <text x={40} y={514} class="g-foot">Trust and conformance registers remain UN/CEFACT public goods hosted by UNECE. The Commons may populate and operate them under revocable, non-exclusive delegation, and never holds the data.</text>
      <text x={40} y={534} class="g-foot-b">Contribution level carries recognition and programme-level earmarking, never representation: two organisations in the same class elect the same representative.</text>
    </svg>
  </div>
</figure>

<style lang="scss">
  .gov {
    margin: var(--spacing-md) 0 0 0;

    // Three columns of boxes cannot be read on a phone, so the figure scrolls on its own axis.
    &_scroll {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    svg {
      display: block;
      width: 100%;
      min-width: 820px;
      height: auto;
    }
  }

  .g-h1 { font-size: 17px; font-weight: 700; fill: #14202B; }
  .g-h2 { font-size: 15px; font-weight: 700; fill: #14202B; }
  .g-h3 { font-size: 13px; font-weight: 700; fill: #14202B; }
  .g-h4 { font-size: 12.5px; font-weight: 700; fill: #14202B; }
  .g-sm { font-size: 11px; fill: #4A5560; }
  .g-row { font-size: 11.5px; fill: #14202B; }
  .g-row-b { font-size: 11.5px; font-weight: 700; fill: #14202B; }
  .g-note { font-size: 10px; fill: #626E7B; }
  .g-it { font-size: 10.5px; font-style: italic; fill: #4A5560; }
  .g-or { font-size: 10.5px; font-style: italic; fill: #626E7B; }
  .g-warn { font-size: 10.5px; font-weight: 700; fill: #A1612A; }
  .g-amber { font-size: 10px; fill: #A1612A; }
  .g-tag { font-size: 9.5px; font-weight: 700; letter-spacing: 0.06em; fill: #0B8171; }
  .g-tag-n { font-size: 9.5px; font-weight: 700; letter-spacing: 0.04em; fill: #626E7B; }
  .g-foot { font-size: 10.5px; fill: #626E7B; }
  .g-foot-b { font-size: 10.5px; font-weight: 600; fill: #0B8171; }
</style>
